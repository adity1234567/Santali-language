            <REF_ANNOTATION ANNOTATION_ID="a489" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>Married</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a490" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>Unmarried</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a491" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>Nina lives in the city with her parents.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a492" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>One day her grandmother sent a letter to her.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a493" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>But Nina could not read that letter.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a494" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>Because, although she can speak her own language, she cannot read.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a495" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>Then Nina's father read the letter to her and explained the meaning.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a496" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>Nina sent some pictures in reply to the letter.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a497" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>A few days later she received another letter from her grandmother.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a498" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>In that letter, the grandmother wrote that she was very happy to receive Nina's pictures.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a499" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>But Nina could not read her letter — she felt upset to know that.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a500" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>Nina then began studying her native language so that she could write letters to her grandmother.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
