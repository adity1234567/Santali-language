        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2" TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>ɟahai̯ manoge gid̪ɾɘ ɔk̚t̪ɛɾenaʔ d̪inisɘd̪ɔko d̪isɘi̯ge.ja</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>sɛt̪aʔɾɛ beɾet̪kat̪ɛ t̪i ɟaŋga ɘɾupsapʰa kat̪ɛ ɟɔm ɲu baɽa kat̪ɛ iskuliɲ calaʔkan t̪ahɛ̃kana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>iskulkʰɔn ɾuɽ kat̪ɛ maɲɟan ɟɔm t̪ajɔm gat̪eko sã͡o̯ ɛnɛʲcʔiɲ calaʔkant̪ahɛ̃kana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
