    <TIER LINGUISTIC_TYPE_REF="utterance" TIER_ID="ref">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1" TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts2">
                <ANNOTATION_VALUE>hɔɽmɔ-ɾɛ gid̪ɾɘ hɛʲc̚ʔ t̪a.jɔm t̪a.jɔm-ge gɔgɔ hɔɽ-aʔ ɖak̚t̪aɾ-ʈʰɛʲc̚ʔ cala-ʔ ɟɘɾuɽ-a</ANNOTATION_VALUE>
