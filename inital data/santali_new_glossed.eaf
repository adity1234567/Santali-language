    <!-- ============================================================ -->
    <!-- TIER 1: ref  – utterance-level IPA transcription             -->
    <!-- ============================================================ -->
    <TIER LINGUISTIC_TYPE_REF="utterance" TIER_ID="ref">

        <!-- SET A: Sentences from part 1 (numbered #10–#17 first group) -->
        <!-- A1 #10: Another name for water is life. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1" TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts2">
                <ANNOTATION_VALUE>d̪aʔ ɾe.jaʔ aɾ miʈɛc͡ʔ ɲut̪um d̪ɔ ɟi.jon</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- A2 #11: My mother's cooking is very delicious. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2" TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>iɲ gɔgɔ-aʔ isin basaŋ d̪ɔ ɘdi sibila</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- A3 #12: My cat meows a lot. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>iɲ-ɾɛn pusi ɘɖi mia͡o mia͡o-ɛ ɾaːga</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- A4 #13: I like my new school very much. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>iɲ d̪ɔ iɲ-aʔ nao̯a iskul ɘɖi aʈiɲ kusi-o̯aʔa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- A5 #14: Every morning father and brother go to the field to see the crops. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>d̪inɘm set̪aʔ-ɾɛ iɲ baba aɾ iɲ bo͡iha baɽgi-ɾɛ abat̪ ɲɛl-kin cala-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- A6 #15: When we go to town we speak Bengali. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>sɔhɔɾ-ɾɛ cala-o̯-lɛn-kʰan abo d̪ɔ baŋla-t̪ɛ-bon ɾɔːɽa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- A7 #16: Eating rice at night makes me sleepy. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>kid̪uʔ ɟɔm lekʰan-gi iɲ d̪ɔ d̪ud̪ɽum-iɲ-ɘ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- A8 #17: Fishes of river are very tasty. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>gaɖa-ɾɛn hako d̪ɔ-ko sibila</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- SET B: Sentences from part 2 (questions, #1–#50) -->
        <!-- B1: Can he/she come today? -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>uni d̪ɔ t̪eheɲ-ɛ hɛc͡ʔ d̪aɽe-ja-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- B2: Do you like to eat spicy food? -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>am d̪ɔ ɟʰal ɟɔm-ɛm kusi-jaʔa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- B3: Should I put sugar in the tea? -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11" TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>caː ɾɛ-ɲ cini-jaʔa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- B4: Did you add salt to the curry? -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>ut̪u-ɾɛ-m buluŋ-ka͡o-d̪a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- B5: Have you read the book? -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>am d̪ɔ no̯a put̪ʰi-m paɽha-o̯-ka-d̪a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- B6: Why didn't he/she go today? -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>uni d̪ɔ t̪eheɲ ced̪aʔ ba-i͡ cala-o̯-le-na</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- B7: When will you return home? -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>am t̪in-ɾɛ ɔɽaʔ-ɛm ɾu̯ɘɽa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- B8: Which direction do I go? -->
        <ANNOTATION>
