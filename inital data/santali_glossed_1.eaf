    <TIER DEFAULT_LOCALE="en" LINGUISTIC_TYPE_REF="Symbolic_Association" TIER_ID="Notes" PARENT_REF="Bangla">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>Glottal-stop ʔ retained morphophonemically; t̪ahɛ̃kana = past copula 'was'.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a10" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>muʲc̚ʔ/muc̚ʔ variants = 'ant'; sɔ͡i̯ = smell/scent (N).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a15" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>ɲɛɭɛɾasa→ɲɛlɛɾasa (typo: ɭ→l). Reduplication ɲu-ɲu marks habitual/continuous.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a20" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>Missing outer brackets in source restored. ked-e-a = 'felt it'; ɲuɲut̪i+ge+i̯ = continuative+focus.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a25" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>ɛnɾɛhɔ̃ = concessive 'even so'; -t̪a- progressive marker.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>Leading '. ' deleted in source. a.jaʔ = aʲaʔ 'his/its'.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a35" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>Correlative t̪inɘʔ...unɘʔ = 'as much...that much'.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a40" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>sahɛ̃t̪ʔ = breath; gɔc̚ʔ = die.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>Stray closing '.ʔ' removed.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>-kin = 3DU subject index; -lɛn- = middle past dual.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>ɘkin = 3DU pronoun; t̪ala 'middle/between'.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>ɔkalɛkat̪ɛhɔ̃ = 'in any way at all'.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a65" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE/>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>miʔ = mit̪ʔ 'one'. Compound past progressive.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>-kʰan = conditional/temporal 'when, if'.</ANNOTATION_VALUE>
