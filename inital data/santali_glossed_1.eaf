            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a456" TIME_SLOT_REF1="ts183" TIME_SLOT_REF2="ts184">
                <ANNOTATION_VALUE>[S8.15] প্রদীপ: উৎসবে কত টাকা লাগবে, কতজন মানুষ লাগবে; সবকিছু নিয়ে আলাপ করতে হবে।</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a461" TIME_SLOT_REF1="ts185" TIME_SLOT_REF2="ts186">
                <ANNOTATION_VALUE>[S8.16] প্রদীপ: কাজ ভালোভাবে করার জন্য একটা কমিটি গঠন করতে হবে।</ANNOTATION_VALUE>
