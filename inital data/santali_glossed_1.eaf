            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a8" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>paɾɔm calaʔ ɟɔkʰɛʲc̚ʔ miʔʈɛʲc̚ʔ mũʲc̚ʔ ɲɛlɛɾasa sɔ͡i̯ ɲamked̪a.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a13" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>uni mũʲc̚ʔ d̪ɔ miʔsɛʲc̚ʔ kʰɔʲc̚ʔ ɲɛɭɛɾasa ɲuɲu͡i̯ ɛhɔp̚ʔena.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a18" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>mit̪̚ʔd̪ʰa͡o̯ ɲɛlɛɾasa ɲu kat̪ɛt̪̚ʔ ɘɖi sibil ked̪e.ja aɾ uni d̪ɔ ɲuɲut̪igei͡i̯ t̪ãhɛ͡i̯na.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a23" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>ɲɛlɛɾasa ɲu ɲut̪ɛ uni.jaʔ laʲc̚ʔ d̪ɔ pʰulɘ͡u̯ɛnt̪a.ja ɛnɾɛhɔ̃ ɲɛlɛɾasa ɲuɲu d̪ɔ ba͡i̯ bɘgi.jad̪a.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a28" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>ɲɛlɛɾasa ɲuɲut̪ɛ unid̪ɔ ɲɛlɛɾasa t̪alaɾɛ͡i̯ bɔlɔ͡i̯na aɾ a.jaʔ ɟaŋga d̪ɔ ɲɛlɛɾasaɾɛ t̪ʰɘli.jɛnt̪a.ja.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a33" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>baɲcaʔ lɘgit̪̚ʔ a.jaʔ kaʈa t̪inɘʔɛ ɔcɔʔɛʔt̪a.ja unɘʔgi bʰit̪ɾisɛʲc̚ʔɛ bɔlɔ cala͡o̯ɛ̆na.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>sahɛ̃t̪̚ʔ bɔnd̪ɔ.jɛnt̪a͡i̯t̪ɛ uni muʲc̚ʔ d̪ɔ mit̪̚ʔgʰɘɽi t̪a͡i̯nɔmɛ gɔʲc̚ʔɛna.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a43" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>a.jaʔ lalɔc̚ʔ ijɘt̪ɛ uni mũʲc̚ʔ d̪ɔ͡i̯ gɔʲc̚ʔena.ʔ</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>mit̪̚ʔʈɛn t̪ɘɾup̚ʔ aɾ mit̪̚ʔʈɛn suk̚ɾi mit̪̚ʔʈɛn kuɲɾɛː d̪aʔ ɲukin cala͡o̯lɛna.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>mɛnkʰan ɔkɔ͡i̯ lahaɾɛ d̪aʔɛː ɲu.ja no̯͡a ni̯͡ɘt̪ɛ ɘkint̪alaɾɛ kɘpɘɾiɘ͡o̯ laga͡ɔ̯ɛna.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>t̪ɘɾup̚ʔ ɔkalɛkat̪ɛhɔ̃ suk̚ɾi lahaɾɛ d̪aʔ ɲu ucu ba͡i̯ kʰɔɟlɛna.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a63" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>suk̚ɾi hɔ̃ t̪ɘɾup̚ʔ lahaɾɛ d̪aʔ ɲu ucu d̪ɔ ba͡i̯ ɾɛbɛnlɛna.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>d̪aɾeɾɛ d̪uɽup̚ʔ kat̪ɛ miʔ ɟʰãk gid̪i d̪ɔ ɘkinaʔ no̯͡a gʰɔʈɔnako ɲɛlɛt̪̚ʔkant̪ãhɛna.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>t̪ɘɾup̚ʔ aɾ suk̚ɾikin gɔʲc̚ʔlɛnkʰan gid̪ikod̪ɔ uŋkinaʔ ɟil jɔmko hud̪isɔʔkan t̪ahɛna.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a76">
