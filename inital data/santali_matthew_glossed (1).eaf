    <TIER LINGUISTIC_TYPE_REF="utterance" TIER_ID="ref">

        <!-- Matt 24:2 — Jisu reak' kathae -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1" TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts2">
                <ANNOTATION_VALUE>d̪ɔ iɲ-ren menak' kat̪ʰa d̪ɔ nɔa-re bam ɲɛl-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:4 — Jisu celakoe metat'koa -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2" TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>d̪ikim naː hɔɽ ba-ku bulauk-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:5 — ere Masiko bulaukoa -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>iɲ d̪o masiʔ kɑn-ɑ men-te ɑdi hɔɽ-ko hiɟ-uk-oa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:6 — larhai reak' udaukope -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>aɾ laɾhai ɾeak' ud̪ãu-ko-pe ahːjom-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:7 — jat uparte jat -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>mit' ɟat̪ d̪o et̪ak' ɟat̪ upaɾ-t̪e aɾ mit' ɾaɟost̪i d̪o et̪ak' ɾaɟost̪i upaɾ-t̪e keŋgon-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:9 — sanam horko thenpe kurud -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>iɲ ɲut̪um-t̪e sanam hɔɽ-ko t̪ʰen-pe kuɽud̪ ok'-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:13 — mucatted do auriak'a -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>menkʰan mucat̪'-t̪et̪' d̪o auɾi-ak'-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:14 — gota dhartire porcarak'a -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>ɡɔt̪a d̪ʰaɾt̪i-ɾe poɾt͡ʃaɾ-ok'-a sanam ɟat̪-ko laɡit̪' ɡɔha ɲut̪um-t̪e</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:21 — maran okoc' santao hoyok'a -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>unɾe d̪o maɾaɲ okot͡ʃ' sant̪ao hɔj-ok'-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:27 — bijli do purub khon -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>t͡ʃet̪' leka bid͡ʒli d̪o puɾub kʰon od̪ok-ok'-t̪e pat͡ʃim habɪt͡ʃ' malkaʔ t͡ʃal-ak'-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:30 — Manwa Hopon reak' seterok' -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11" TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>unɾe manwa hopon ɾeak' t͡ʃinʰa seɾmaɾe ɲel-ok'-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:35 — Serma ar ot do cabak'a -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>seɾma aɾ ot̪ d̪o t͡ʃabak'-a menkʰan iʔak' kat̪ʰa-ko d̪o ohoɡe t͡ʃabal-ena</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:36 — onadinreak' okoe ho bako badaea -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>menkʰan ona d̪in aɾ ɡʰuɾi ɾeak' d̪o okoe hɔ̃ bako bad̪aea</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:37 — Noah reak' dinkore hoelena -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>aɾ t͡ʃet̪' leka noa-ʔ ɾeak' d̪in-koɾe hɔelena onkage manwa hopon ɾeak' set̪eɾok' hɔ hɔj-ok'-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 24:42 — jagwarakae tahenpe -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>ɔnat̪e ɟaɡwaɾakae t̪ahen-pe ente bape bad̪aea oka hilok' apeɾen pɾɔbʰui hiɟ-uk'-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 25:1 — serma raj gel tetre kuriko lekak'a -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>unɾe seɾma ɾaɟ d̪o ɡel t̪et̪ɾe kuɾi-ko lekak'-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 25:5 — jawaye bilomenta jotoge dudrumket'koa -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17" TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>ad̪o ɟãwãe-ye bilom-ente ɟot̪oɡe d̪ud̪ɾumket̪'-koa aɾ-ko ɟapit̪'-keda</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 25:8 — budanko do menkeda -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>d̪en apeʔak' sunum hat̪iɲale-pe ente aleak' d̪iuhe-ko aʔ iɾiɟ-ok'-kana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 25:13 — ente dintetT' ao bape badaea -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>ad̪o ɟaɡwaɾakae baɾe t̪ahen-pe ente d̪int̪et̪' aʔo bape bad̪aea aɾ ɡʰuɾit̪et̪' hɔ̃ baɲ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 25:21 — Besakadam E bhage ar patiar golam -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>besak-ad̪am e bʰaɡe aɾ pat̪iaɾ ɡolam t̪ʰoɾawak'-ɾe pat̪iaɾ-em t̪ahen-kana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 25:29 — menak'ae mimit' hor doe em ocok'a ar sareyok'aea -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21" TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>ente menak'-ae mimit̪' hɔɽ d̪oe em ok'-a aɾ saɾeɾ-ok'-aea menkʰan banuikae hɔɽ d̪o ɟahanakad̪e menak'tae ona hɔ uni t̪ʰen kʰon ɾeɟoɡ-ok'-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 25:31 — Manwa Hopon ac'ren sanam dutko sãote -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>menkʰan manwa hopon at͡ʃ'-ɾen sanam d̪ut̪-ko sɔt̪e at͡ʃ'ak' t̪ʰonok-ɾe-ye d̪uɾup'-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 25:35 — rengec'ledinna ar jomak' pe emadinna -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>ente ɾeŋet͡ʃ'-led̪iɲɲa aɾ ɟɔmak' pe emad̪iɲa t̪et̪aɲled̪iɲa aɾ-pe naʔ ok'-led̪iɲa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 26:2 — barsin khange senparom porob hoyok'a -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>bad̪aeɡe ape baɾsiɲ kʰaŋɡe senpaɾom poɾob hɔj-ok'-a aɾ manwa hopon d̪o kɾus ok'-ok' laɡit̪' sopɾot̪ ok'-ok'-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 26:7 — maejiu alabastar sunumante hece'na -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>mit̪t̪en maeɟiu alabastaɾ t͡ʃukat̪'-ɾe ad̪i d̪amanak' maʔkaoʔ sunum-ant̪e uni t̪ʰen-e het͡ʃ'-ena</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 26:10 — Jisu metadea — Maejiu cedak'pe duk ocoye -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>ɟisu d̪o ona bad̪aeket̪'e metat̪'-koa maeɟiu t͡ʃed̪ak'-pe d̪uk ok'-o-je-kana ente iɲ laɡit̪' besak'-e kami-ak-ad̪a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 26:15 — Tinek' pe emana uniñ soprota pe khan -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>t̪inak'-pe emana uniɲ sopɾot̪-a-pe kʰan onko d̪o pe ɡel t̪aka-ko lekʰawad̪ea</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 26:26 — Ne ataŋte jompe noa do iñak' hormo kana -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>ne at̪aŋ-t̪e ɟɔm-pe noa d̪o iɲak' hɔɾmo kana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 26:31 — Nia ninda ape jotoge ińrepe takijok'a -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>nia niɲd̪a ape ɟot̪oɡe iɲ-ɾe-pe t̪aki-ɟ-ok'-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 26:39 — É Apuñ hoe dareak' khan noa bati ińthen khon calao paramok' ma -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30" TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>e apuɲ hoe d̪aɾeak' kʰan noa bat̪i d̪o iɲ t̪ʰen kʰon t͡ʃalao paɾam-ok' ma baɲ bik-om amem men-ɟɔɲ-kan' leka baɾe hɔj-ok'-ma</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

    </TIER>

