        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>seɾma aɾ ot̪ d̪o t͡ʃab-ak'-a menkʰan iʔ-ak' kat̪ʰa-ko d̪o ohoɡe t͡ʃabal-ena</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a43" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>menkʰan ona d̪in aɾ ɡʰuɾi ɾeak' d̪o okoe hɔ̃ ba-ko bad̪a-ea</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>aɾ t͡ʃet̪' leka noa-ʔ ɾeak' d̪in-koɾe hɔe-lena onkaɡe manwa hopon ɾeak' set̪eɾ-ok' hɔ hɔj-ok'-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>ɔnat̪e ɟaɡwaɾ-akae t̪ahen-pe ente ba-pe bad̪a-ea oka hilok' ape-ɾen pɾɔbʰui hiɟ-uk'-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>un-ɾe seɾma ɾaɟ d̪o ɡel t̪et̪ɾe kuɾi-ko lekak'-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a47" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>ad̪o ɟãwãe-ye bilom-ente ɟot̪oɡe d̪ud̪ɾum-ket̪'-koa aɾ-ko ɟapit̪'-keda</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>d̪en ape-ak' sunum hat̪iɲale-pe ente ale-ak' d̪iuhe-ko aʔ iɾiɟ-ok'-kana</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>ad̪o ɟaɡwaɾ-akae baɾe t̪ahen-pe ente d̪in-t̪et̪' aʔo ba-pe bad̪a-ea aɾ ɡʰuɾi-t̪et̪' hɔ̃ ba-ɲ</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>besak-ad̪am e bʰaɡe aɾ pat̪iaɾ ɡolam t̪ʰoɾawak'-ɾe pat̪iaɾ-em t̪ahen-kana</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>ente menak'-ae mimit̪' hɔɽ d̪oe em ok'-a aɾ saɾeɾ-ok'-aea menkʰan banuik-ae hɔɽ d̪o ɟahan-akad̪e menak'-t̪ae ona hɔ uni t̪ʰen kʰon ɾeɟ-oɡ-ok'-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>menkʰan manwa hopon at͡ʃ'-ɾen sanam d̪ut̪-ko sɔt̪e at͡ʃ'-ak' t̪ʰonok-ɾe-ye d̪uɾup'-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>ente ɾeŋet͡ʃ'-led̪-iɲ-ɲa aɾ ɟɔm-ak' pe em-ad̪-iɲa t̪et̪-aɲ-led̪-iɲa aɾ-pe naʔ ok'-led̪-iɲa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>bad̪ae-ɡe ape baɾ-siɲ kʰaŋɡe senpaɾom poɾob hɔj-ok'-a aɾ manwa hopon d̪o kɾus ok'-ok' laɡit̪' sopɾot̪ ok'-ok'-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>mit̪'-t̪en maeɟiu alabastaɾ t͡ʃukat̪'-ɾe ad̪i d̪amanak' maʔkaok' sunum-ant̪e uni t̪ʰen-e het͡ʃ'-ena</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>ɟisu d̪o ona bad̪ae-ket̪'-e metat̪'-koa maeɟiu t͡ʃed̪ak'-pe d̪uk ok'-o-ye-kana ente iɲ laɡit̪' besak'-e kami-ak-ad̪a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>t̪inak'-pe em-ana uniɲ sopɾot̪-a-pe kʰan onko d̪o pe ɡel t̪aka-ko lekʰawad̪ea</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>ne at̪aŋ-t̪e ɟɔm-pe noa d̪o iɲ-ak' hɔɾmo kana</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>nia niɲd̪a ape ɟot̪oɡe iɲ-ɾe-pe t̪aki-ɟ-ok'-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>e apuɲ hoe d̪aɾe-ak' kʰan noa bat̪i d̪o iɲ t̪ʰen kʰon t͡ʃalao paɾam-ok' ma baɲ bik-om amem men-ɟɔɲ-kan' leka baɾe hɔj-ok'-ma</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

    </TIER>

