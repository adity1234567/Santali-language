    <TIER LINGUISTIC_TYPE_REF="translation" PARENT_REF="ref" TIER_ID="ft">

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>Mother, younger brother will go to school for the first time today.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>He is afraid to go to school.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>What shall I do now, Mother?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>It will be fine if you go to school with him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a77" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>If you stay with him, he will not be afraid.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>I will certainly go with him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a79" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>He will be alone in the class; then he might get scared.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>There is nothing to be afraid of.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a81" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>Now he will play more than study.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>This is better than studying suddenly.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a83" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>He can do many things though.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>He knows the letters and alphabets, can count, and can name the months and days.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a85" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>But can he state his home address?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>I think he still cannot do this.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Why does he need to know these?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>All children need to know these things.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a89" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>So that they can answer if someone asks.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a90" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>Besides, if he knows these, he will not get lost.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a91" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>You are right, Mother.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>What things need to be bought for him?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a93" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>Need to buy a school bag, paper, pencil, eraser, and sharpener.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>Alright, I am taking him to the shop now.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>It would be better if he buys the things he likes himself.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>Yes, tomorrow you will take him to school.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

    </TIER>

