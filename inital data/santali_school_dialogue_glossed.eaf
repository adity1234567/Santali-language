    <!-- ============================================================ -->
    <!-- TIER: ref — utterance (IPA transcription, time-aligned)      -->
    <!-- ============================================================ -->
    <TIER LINGUISTIC_TYPE_REF="utterance" TIER_ID="ref">

        <!-- U1: Elder sister: Mother, younger brother will go to school for the first time today. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1" TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts2">
                <ANNOTATION_VALUE>gɔː huɖiɲ bɔ͡i̯ha d̪ɔ t̪eheɲ pɘhil d̪ʰa͡o̯ iskulɛ calaʔa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U2: Elder sister: He is being afraid to go to school. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2" TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>uni d̪ɔ iskul calaʔɛ bɔt̪ɔɾɔʔ kana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U3: Elder sister: What will I do now, Mother? -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>nit̪̚ cɛʔiɲ ceka ja gɔː</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U4: Mother: It will be okay if you go to school with him. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>uni sã͡ɔ̯t̪ɛ am d̪ɔ iskulɛ m cala͡o̯lɛnkʰange ho jo a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U5: Mother: If you are with him, he will not be afraid. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>uni sã͡o̯ɾɛ m t̪ahɛ̃lɛnkʰan ba͡i̯ bɔt̪ɔɾɔ a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U6: Elder sister: I will definitely go with him. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>iɲ d̪ɔ ɔbɔs ge uni sã͡o̯t̪ɛ ɲ cala a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U7: Elder sister: He will be alone in the class, then he might get scared. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>uni d̪ɔ klasɾɛ eɛs kaɾge͡i̯ t̪ahɛ̃na unɾɛ͡i̯ bɔt̪ɔɾ d̪aɽe jaʔa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U8: Mother: There is nothing to be afraid of. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>bɔt̪ɔɾɔʔ ɾenaʔ cɛt̪̚ʔ hɔ̃ bɘnu a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U9: Mother: Now he will play more than studying. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>nit̪̚ d̪ɔ uni ɔlɔʔ paɽhaʔ bɔd̪ɔlt̪ɛ gate ʔge ɟɘst̪i͡i̯ kusi a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U10: Mother: This is better than studying suddenly. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>ac̚ka ac̚ka paɽhaʔ bɔd̪ɔlt̪ɛ no̯͡a kɘmi ge boge ja</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U11: Elder sister: He can do many things though. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11" TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>mɛnɛʔ uni d̪ɔ a͡i̯ma ge͡i̯ d̪aɽe jaʔa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U12: Elder sister: He knows letters/alphabets, can count, can name the months and days. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>uni d̪ɔ haɾɔp̚ko bɔɾnɔmalako lɛkʰa cand̪o aɾ d̪in ɾe jaʔ ɲit̪umɛ ɾɔɽ d̪aɽe o̯͡aʔa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U13: Mother: But can he state his home address? -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>cɛt̪̚ʔ uni d̪ɔ a jaʔ ɔɽaʔ ɾenaʔ ʈʰikana͡i̯ lɘ͡͡i̯ d̪aɽe jaʔa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U14: Elder sister: I think he still can't do this. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>hud̪i sid̪ɘɲ uni d̪ɔ no̯͡a nit̪̚ hɔ̃ ba͡i̯ lɘ͡i̯ d̪aɽe jaʔa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U15: Elder sister: Why should he know these? -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>no̯͡a d̪ɔ ced̪aʔ baɖa͡i̯ ɟɘɾuɽ ta ja</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U16: Mother: All children need to know these. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>ɟɔt̪ɔ gid̪ɾɘo̯͡aʔ ge no̯͡ako baɖa͡i̯ d̪ɔ ɟɘɾuɽ ge ja</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U17: Mother: So they can answer if someone asks. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17" TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>ɟãhã͡i̯ko kuli̯͡ɛɾɛ ɟɛmɔnɛ lɘ͡i̯ d̪aɽe jaʔ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U18: Mother: Besides, if he knows these things, he will not get lost. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>ɔna cʰaɖa no̯͡a baɖa͡i̯ t̪ahɛn kʰan ba͡i̯ ad̪ɔʔa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U19: Elder sister: You are right, mother. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>am d̪ɔ ʈʰik ge m mɛne d̪a gɔ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U20: Elder sister: What things to buy for him? -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>uni lɘgit̪̚ʔ cɛt̪̚ʔ cɛt̪̚ʔ ko kiɾiɲ ɟɘɾuɽa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U21: Mother: Have to buy a school bag, paper, pencil, eraser, sharpener. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21" TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>iskul bɛg kagɔc̚ pensil iɾeɟaɾ saɾp̚naɾ no̯͡ako kiɾiɲ ɟɘɾuɽa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U22: Elder sister: Alright, I am taking him to the shop. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>ac̚cʰa uni ni jɘ ge d̪okani ɲ calaʔ kana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U23: Elder sister: It would be better if he buys the things he likes. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>uni d̪ɔ aʲcʔ kusiʔ lekan ɟinis ko kiɾiɲ lekʰan boge ho jo a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- U24: Mother: Yes, you will take him to school tomorrow. -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>hɛ̃ gapa d̪ɔ uni ni͡ɘ̯ iskul ɛ m cala a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

    </TIER>

    <!-- ============================================================ -->
    <!-- TIER: mb — morpheme break (IPA with morpheme boundaries)     -->
    <!-- ============================================================ -->
    <TIER LINGUISTIC_TYPE_REF="morpheme" PARENT_REF="ref" TIER_ID="mb">

        <!-- U1: gɔː huɖ-iɲ bɔ͡i̯ha d̪ɔ t̪eheɲ pɘhil d̪ʰa͡o̯ iskul-ɛ cala-ʔ-a -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a25" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>gɔː huɖ-iɲ bɔ͡i̯ha d̪ɔ t̪eheɲ pɘhil d̪ʰa͡o̯ iskul-ɛ cala-ʔ-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U2: uni d̪ɔ iskul cala-ʔ-ɛ bɔt̪ɔɾɔ-ʔ kan-a -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a26" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>uni d̪ɔ iskul cala-ʔ-ɛ bɔt̪ɔɾɔ-ʔ kan-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U3: nit̪̚ cɛ-ʔ-iɲ cek-a ja gɔː -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a27" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>nit̪̚ cɛ-ʔ-iɲ cek-a ja gɔː</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U4: uni sã͡ɔ̯t̪ɛ am d̪ɔ iskul-ɛ -m cala͡o̯-lɛn-kʰan-ge ho-jo-a -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a28" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>uni sã͡ɔ̯t̪ɛ am d̪ɔ iskul-ɛ -m cala͡o̯-lɛn-kʰan-ge ho-jo-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U5: uni sã͡o̯ɾɛ -m t̪ahɛ̃-lɛn-kʰan ba-͡i̯ bɔt̪ɔɾɔ-a -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a29" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>uni sã͡o̯ɾɛ -m t̪ahɛ̃-lɛn-kʰan ba-͡i̯ bɔt̪ɔɾɔ-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U6: iɲ d̪ɔ ɔbɔs ge uni sã͡o̯t̪ɛ -ɲ cala-a -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a30" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>iɲ d̪ɔ ɔbɔs ge uni sã͡o̯t̪ɛ -ɲ cala-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U7: uni d̪ɔ klas-ɾɛ eɛs kaɾ-ge-͡i̯ t̪ahɛ̃-na uni-ɾɛ-͡i̯ bɔt̪ɔɾ d̪aɽe-ja-ʔ-a -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a31" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>uni d̪ɔ klas-ɾɛ eɛs kaɾ-ge-͡i̯ t̪ahɛ̃-na uni-ɾɛ-͡i̯ bɔt̪ɔɾ d̪aɽe-ja-ʔ-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U8: bɔt̪ɔɾɔ-ʔ ɾenaʔ cɛt̪̚ʔ hɔ̃ bɘnu-a -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a32" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>bɔt̪ɔɾɔ-ʔ ɾenaʔ cɛt̪̚ʔ hɔ̃ bɘnu-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U9: nit̪̚ d̪ɔ uni ɔlɔʔ paɽha-ʔ bɔd̪ɔl-t̪ɛ gate-ʔ-ge ɟɘst̪i-͡i̯ kusi-a -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a33" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>nit̪̚ d̪ɔ uni ɔlɔʔ paɽha-ʔ bɔd̪ɔl-t̪ɛ gate-ʔ-ge ɟɘst̪i-͡i̯ kusi-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U10: ac̚ka ac̚ka paɽha-ʔ bɔd̪ɔl-t̪ɛ no̯͡a kɘmi-ge boge-ja -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a34" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>ac̚ka ac̚ka paɽha-ʔ bɔd̪ɔl-t̪ɛ no̯͡a kɘmi-ge boge-ja</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U11: mɛnɛʔ uni d̪ɔ a͡i̯ma-ge-͡i̯ d̪aɽe-ja-ʔ-a -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a35" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>mɛnɛʔ uni d̪ɔ a͡i̯ma-ge-͡i̯ d̪aɽe-ja-ʔ-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U12: uni d̪ɔ haɾɔp̚-ko bɔɾnɔmala-ko lɛkʰa cand̪o aɾ d̪in ɾenaʔ ɲit̪um-ɛ ɾɔɽ d̪aɽe-o̯͡a-ʔ-a -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a36" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>uni d̪ɔ haɾɔp̚-ko bɔɾnɔmala-ko lɛkʰa cand̪o aɾ d̪in ɾenaʔ ɲit̪um-ɛ ɾɔɽ d̪aɽe-o̯͡a-ʔ-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U13: cɛt̪̚ʔ uni d̪ɔ a-jaʔ ɔɽaʔ ɾenaʔ ʈʰikana-͡i̯ lɘ-͡i̯ d̪aɽe-jaʔ-a -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a37" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>cɛt̪̚ʔ uni d̪ɔ a-jaʔ ɔɽaʔ ɾenaʔ ʈʰikana-͡i̯ lɘ-͡i̯ d̪aɽe-jaʔ-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U14: hud̪i sid̪-ɘɲ uni d̪ɔ no̯͡a nit̪̚ hɔ̃ ba-͡i̯ lɘ-͡i̯ d̪aɽe-jaʔ-a -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a38" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>hud̪i sid̪-ɘɲ uni d̪ɔ no̯͡a nit̪̚ hɔ̃ ba-͡i̯ lɘ-͡i̯ d̪aɽe-jaʔ-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U15: no̯͡a d̪ɔ ced̪aʔ baɖa-͡i̯ ɟɘɾuɽ-ta-ja -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a39" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>no̯͡a d̪ɔ ced̪aʔ baɖa-͡i̯ ɟɘɾuɽ-ta-ja</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- U16: ɟɔt̪ɔ gid̪ɾɘ-o̯͡aʔ-ge no̯͡a-ko baɖa-͡i̯ d̪ɔ ɟɘɾuɽ-ge-ja -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a40" ANNOTATION_REF="a16">
