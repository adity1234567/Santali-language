            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>t̪ahɔlɛ iɲd̪ɔ aːɾhɔ̃ ɔɽaʔ calaʔ ho.joʔt̪iɲɘ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- D1-U13: SR to Officer -->
