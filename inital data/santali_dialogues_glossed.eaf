        <!-- === DIALOGUE 1: POLICE STATION === -->
        <!-- D1-U1: Officer to SR -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1" TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts2">
                <ANNOTATION_VALUE>cɛʔlɛkat̪ɛɲ gɔɽɔ d̪aɽeo̯͡ama</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- D1-U2: SR to Officer -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2" TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>iɲaʔ mɔbaĭl pʰoniɲ at̪̚ʔakad̪a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- D1-U3: SR to Officer -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>ɔna pʰɔn d̪ɔ ɘɖi ɟɘɾuɽt̪iɲ ced̪aʔ ɟe ɔna pʰonɾɛ ɘɖi ɟɘɾuɽ ɟɘɾuɽ pʰɔʈɔ mena.a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- D1-U4: Officer to SR -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>cekat̪ɛm at̪̚ʔked̪a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- D1-U5: SR to Officer -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>basɾɛ d̪ɛɟoʔ ɟɔkʰɛʲc̚ʔ iɲaʔ gubliɾɛɲ d̪ɔhɔleda</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- D1-U6: SR to Officer -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>bas kʰɔn pʰɛɖ̚kat̪ɛ ɔna d̪ɔ aɾ bɘɲ send̪ɾa ɲam led̪a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- D1-U7: SR to Officer -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>ho͡i̯ d̪aɽe.jaʔa gubli kʰɔn ɲuɾena aɾ baŋkʰan gubli kʰɔn kumɾu.jɛnt̪ama</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- D1-U8: Officer to SR -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>amd̪ɔ miʔʈɛʲc̚ʔ ɟiɖi͡i̯ ho.joʔt̪ama</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- D1-U9: Officer to SR -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>ɟiɖi͡i̯ lɘgit̪̚ʔ amaʔ ɟat̪i̯͡o oɾom kagɔc̚ aɾ mɔbaĭl pʰon ɾe.jaʔ a͡i̯.em.i.a͡i̯ nɔmbɔɾ laga.a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- D1-U10: SR to Officer -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>iɲaʔ ɟati̯͡ɔ̯ oɾom kagɔɟ d̪ɔ mena.a mɛnkʰan iɲaʔ mɔbaĭl pʰon ɾejaʔ a͡i̯.em.i.a͡i̯ nɔmbɔɾ d̪ɔ ɔkaɾɛɲ ɲama</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- D1-U11: Officer to SR -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11" TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>amaʔ mɔbaĭl pʰon ɾejaʔ pekeʈ̚ ɾigi ona nɔmbɔɾ d̪ɔ ɔl mena.a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <!-- D1-U12: SR to Officer -->
