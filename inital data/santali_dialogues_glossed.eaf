                <ANNOTATION_VALUE>careful-CVB 1SG-GEN speech listen for 2PL-EMPH very thank_you-CVB</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

    </TIER>

    <!-- TIER 4: ft - free translation tier (INCLUDED_IN ref) -->
    <TIER LINGUISTIC_TYPE_REF="translation" PARENT_REF="ref" TIER_ID="ft">

        <!-- D1 translations -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d1" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>How may I help you?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d2" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>My mobile phone is lost.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d3" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>That phone is very much needed, because I have many important pictures in there.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d4" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>How did you lose it?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d5" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>I put it in my pocket while boarding the bus.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d6" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>I couldn't find it anymore after getting off the bus.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d7" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>It may have fallen out of the pocket, or someone has stolen it from the pocket.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d8" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>You have to file a GD.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d9" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>To file a GD you will need your national identity card and the IMEI number of the mobile phone.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d10" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>I have a national identity card, but where do I get the IMEI number?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d11" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>That number is written on your mobile phone's packet.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d12" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>Then I have to go home again.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d13" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>But I cannot write!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d14" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>No problem.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d15" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>The officer who will be here will help you write the GD.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d16" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>Remember to take a photocopy of the GD with you.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d17" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>Thank you very much.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- D2 translations -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d18" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>I will go to Dhaka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d19" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>Do you have any vehicle going toward Dhaka?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d20" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>Yes, there is.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d21" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>When do you want to leave?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d22" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>It would be better for me to get the afternoon vehicle.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d23" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Excuse us.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d24" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>We don't have any vehicles this afternoon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d25" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>You can go in the morning and at night.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d26" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>What time does the night vehicle leave?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d27" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>The vehicle will leave the bus terminal at 10:30 PM.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d28" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>You will be at the counter by 09:45 PM.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d29" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>How much is the ticket?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d30" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>BDT 550.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d31" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>Please give me a ticket.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d32" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>Here is your ticket.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d33" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>May you go safely.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <!-- D3 translations -->
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d34" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>Students, do you know the purpose of education?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d35" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>We don't know, sir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d36" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>The purpose of education is to change behavior.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d37" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>That's why today we will talk about manners and etiquette in class.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d38" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>What do we have to learn, sir?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d39" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>When the teacher enters the class, everyone will stand and salute him/her.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d40" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>We do that, sir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d41" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>What else do we need to do, sir?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d42" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>You will help each other.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d43" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>Listen carefully to others.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d44" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>You will not quarrel with anyone.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d45" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>Elders will show affection to the younger ones.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d46" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>The younger ones shall respect the elders.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d47" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>Sir, what if the younger ones do not listen to us?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d48" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>At first, explain it to them.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d49" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>Even then, if they don't listen, you will discipline them.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d50" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>Got it, sir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d51" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>Don't litter anywhere.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d52" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>When crossing the road, look carefully on both sides before crossing.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d53" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>Otherwise, you might get hit by a vehicle.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d54" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>Yes, sir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d55" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>Don't scold anyone.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d56" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>Do not compare one person with another.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d57" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>Do not condemn anyone.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d58" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>Thank you very much, sir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="d59" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>Thank you for listening carefully to me.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

    </TIER>

