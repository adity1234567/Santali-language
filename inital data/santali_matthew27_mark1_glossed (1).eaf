    <!-- ============================================================
         TIER 1: ref — utterance-level IPA (time-aligned)
         Sources: Matthew 27:3–28:20; Mark 1:1–21
         30 representative utterances
         ============================================================ -->
    <TIER LINGUISTIC_TYPE_REF="utterance" TIER_ID="ref">

        <!-- Matt 27:4 — Jihuda kastaoena: kaiakadah miridog miñayam joro ocoakatte -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1" TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts2">
                <ANNOTATION_VALUE>kaiakad̪ah miɾid̪os miɲajam ɟoɾo ok'-akat̪-t̪e</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 27:5 — taka mundilre capar gidikate calaoena ar senkate phasi docena -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2" TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>t̪akamund̪il-ɾe t͡ʃapaɾ ɡid̪ikat̪-e t͡ʃalao-ena aɾ senkat̪-e pʰasi d̪ot͡ʃ-ena</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 27:11 — Am do Jihudikoren raj kanam? -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>am d̪o ɟiʰud̪ikoɾen ɾaɟ kan-am</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 27:11 — Jisui menkeda: Amem meneda -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>ɟisu-i menkeda amem men-ed̪a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 27:22 — Endekhan Masiko metae Jisu don cekayea? -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>end̪ekʰan masiʔ-ko met̪ae ɟisu d̪oɲ t͡ʃekajeːa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 27:22 — Jotogeko menkeda, Krus ocok'mae -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>ɟot̪oɡe-ko menkeda kɾus ok'-ok'-mae</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 27:24 — Pilate dak' hataokate tiye abukena ar menkeda: in don miridosgea -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>pilat̪ d̪ak' hat̪ao-kat̪-e t̪ij-e abuk-ena aɾ menkeda iɲ d̪oɲ miɾid̪os-ɡea noa maːjam kʰon d̪o</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 27:25 — Sanam horko ror ruarkeda: Uniak' mayam do alere ar aleren gidrakore parok'ta -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8" TIME_SLOT_REF1="ts15" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>sanam hɔɽ-ko ɾoɾ ɾuaɾkeda uniʔak' maːjam d̪o ale-ɾe aɾ aleɾen ɡid̪ɾa-koɾe paɾok'-t̪a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 27:29 — Johar, Jihudikoren raj -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>ɟohaɾ ɟiʰud̪ikoɾen ɾaɟ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 27:37 — NUI DO JISU JIHUDIKOREN RAJ KANAE -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>nui d̪o ɟisu ɟiʰud̪ikoɾen ɾaɟ kana-e</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 27:40 — Isorren Hopon kanam men khan, krus khon argon me -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11" TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>isoɾ-ɾen hopon kan-am men-kʰan kɾus kʰon aɾɡon-me</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 27:42 — Israel koren raj kanae, nitok' krus khone argo hijuk'ma, ado unire bon patiauk'a -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12" TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts24">
                <ANNOTATION_VALUE>isɾael-koɾen ɾaɟ kana-e nit̪ok' kɾus kʰon-e aɾɡo hiɟ-uk'-ma ad̪o uni-ɾe bon pat̪iau-k'-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 27:46 — Eli, Eli lama sabakthani — E iñren Isor, E iñren Isor, cetak'er bagi gidiadiña -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13" TIME_SLOT_REF1="ts25" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>eli eli lama sabakt̪ʰani metak'-me e iɲ-ɾen isoɾ e iɲ-ɾen isoɾ t͡ʃet̪ak'-eɾ baɡi ɡid̪iad̪-iɲa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 27:54 — Subedar: Sarige nui do Isorren Hopone tahekana -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>saɾiɡe nui d̪o isoɾ-ɾen hopon-e t̪ahen-kana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 28:5–6 — dut maejiue metat'kina: Aloben botorok'a; krus ocolen Jisuben ñamekana -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>alo-ben bot̪oɾok'-a kɾus ok'-ol-en ɟisuben ɲam-ekana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 28:7 — senkate uniren cela laiakoben goc'ko khone jiweT beret'ena -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>senkat̪-e uniɾen t͡ʃela lajakoben ɡot͡ʃ'-ko kʰon-e ɟiwet̪' beɾet̪'-ena</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 28:10 — Jisu metat'kina: Aloben botorok'a; senkate iñren boehako laiakoben jemon Galilteko calak' -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17" TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>alo-ben bot̪oɾ-ok'-a senkat̪-e iɲ-ɾen boeha-ko lajakoben ɟemon ɡalil-t̪e-ko t͡ʃalak'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 28:18 — Sermare ar otre sanam ektiari in then emakana -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>seɾmaɾe aɾ ot̪ɾe sanam ekt̪iaɾi iɲ t̪ʰen emakana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 28:19 — Senkate sanam jatko celakope, ar Baba ar Hopon ar Sonot Jiu ħutumte baptiskope -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>senkat̪-e sanam ɟat̪-ko t͡ʃela-ko-pe aɾ baba aɾ hopon aɾ sonot̪ ɟiu ɲut̪um-t̪e bapt̪is-ko-pe</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Matt 28:20 — in do jao hilok' ape tuluc' menaña, jug mucat' habic'ge -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>iɲ d̪o ɟao hilok' ape t̪ulut͡ʃ' menaɲa ɟuɡ mukat̪' habɪt͡ʃ'-ɡe</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Mark 1:1 — Isorren Hopon Jisu Masiak' bhage sombat reak' etohop' -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21" TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>isoɾ-ɾen hopon ɟisu masiak' bʰaɡe sombat̪ ɾeak' et̪ohop'</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Mark 1:4 — Johan babaptisic' do hahankarre kai ikak' lagit' mon acur reak' baptisma porcarkan hec'ena -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>ɟohan babaptisit͡ʃ' d̪o ɦaɦankaɾ-ɾe kai ikak' laɡit̪' mon at͡ʃuɾ ɾeak' bapt̪isma poɾt͡ʃaɾ-kan het͡ʃ'-ena</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Mark 1:7 — Iñ khon dareanic' iñ tayomte daraekana, one uniak' kharpa reak' tonol ho engot'kate raraetae lek don ban kan -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>iɲ kʰon d̪aɾeaniʔ iɲ t̪ajom-t̪e d̪aɾaekana one uniʔak' kʰaɾpa ɾeak' t̪onol hɔ̃ eŋɡot̪'-kat̪e ɾaɾaet̪ae lek d̪oɲ baɲ kan</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Mark 1:8 — Iñ do dak'ten baptiskedea, uni do Sonot Jiuteye baptispea -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a24" TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts48">
                <ANNOTATION_VALUE>iɲ d̪o d̪ak'-t̪en bapt̪iskед-ea uni d̪o sonot̪ ɟiu-t̪-e-je bapt̪is-pe-a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Mark 1:11 — serma khon aran hoyena: Am do iñren dularia Hopon kanam, arñren kusiakana -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25" TIME_SLOT_REF1="ts49" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>seɾma kʰon aɾan hɔj-ena am d̪o iɲ-ɾen d̪ulaɾia hopon kan-am aɾɲɾen kusiak-ana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Mark 1:15 — Okte ao purauakana ar Isorak' raj do sorakana; mon acur pe ar bhage sombatre patiauk'pe -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26" TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>okt̪e aʔo puɾau-akana aɾ isoɾ-ak' ɾaɟ d̪o soɾak-ana mon at͡ʃuɾ-pe aɾ bʰaɡe sombat̪-ɾe pat̪iau-k'-pe</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Mark 1:17 — Dela iñ tayomte, ado manwa sasap' keotan hoe ocobena -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27" TIME_SLOT_REF1="ts53" TIME_SLOT_REF2="ts54">
                <ANNOTATION_VALUE>d̪ela iɲ t̪ajom-t̪e ad̪o manwa sasap' keot̪an hoe ok'-ob-ena</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Mark 1:18 — Khan ina taptege jalko bagiat'tekin panjakeda -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a28" TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts56">
                <ANNOTATION_VALUE>kʰan ina t̪apt̪-eɡe ɟal-ko baɡiat̪'-t̪ekin panɟakeda</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Mark 1:20 — khange akinren apat Sabdae do laukare munisko tuluc'kin bagi otoadea ar uni tayomtekin calaoena -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a29" TIME_SLOT_REF1="ts57" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>kʰaŋɡe akin-ɾen apat̪ sabd̪ae d̪o laukaɾe munis-ko t̪ulut͡ʃ'-kin baɡi ot̪oad̪ea aɾ uni t̪ajom-t̪ekin t͡ʃalao-ena</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

        <!-- Mark 1:21 — ar pahil jirauk' maha hilok'ge sunagogre boloyenteye cet'at'koa -->
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a30" TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts60">
                <ANNOTATION_VALUE>aɾ paɦil ɟiɾauk' maɦa hilok'-ɡe sunaɡoɡ-ɾe boloj-ent̪e-je t͡ʃet̪'at̪'-koa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>

    </TIER>

