    <!-- ============================================================
         TIER 4: ft — free translation (INCLUDED_IN child of ref)
         ============================================================ -->
    <TIER LINGUISTIC_TYPE_REF="translation" PARENT_REF="ref" TIER_ID="ft">

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a91" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>I have sinned by betraying innocent blood.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>And throwing down the pieces of silver in the temple, he departed, and he went and hanged himself.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a93" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>Are you the King of the Jews?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>Jesus said, "You have said so."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>What shall I do then with Jesus who is called Christ?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>They all said, "Let him be crucified!"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a97" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>Pilate washed his hands before the crowd, saying, "I am innocent of this man's blood; see to it yourselves."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>And all the people answered, "His blood be on us and on our children!"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>Hail, King of the Jews!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>This is Jesus, the King of the Jews.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>If you are the Son of God, come down from the cross.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>He is the King of Israel; let him come down now from the cross, and we will believe in him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a103" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>Eli, Eli, lema sabachthani? That is, "My God, my God, why have you forsaken me?"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a104" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>Truly this was the Son of God!</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a105" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Do not be afraid, for I know that you seek Jesus who was crucified.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a106" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>Then go quickly and tell his disciples that he has risen from the dead.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a107" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>Do not be afraid; go and tell my brothers to go to Galilee, and there they will see me.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a108" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>All authority in heaven and on earth has been given to me.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a109" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>Go therefore and make disciples of all nations, baptising them in the name of the Father and of the Son and of the Holy Spirit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a110" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>And behold, I am with you always, to the end of the age.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a111" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>The beginning of the gospel of Jesus Christ, the Son of God.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a112" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>John appeared, baptising in the wilderness and proclaiming a baptism of repentance for the forgiveness of sins.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a113" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>After me comes he who is mightier than I, the strap of whose sandals I am not worthy to stoop down and untie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a114" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>I have baptised you with water, but he will baptise you with the Holy Spirit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a115" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>And a voice came from heaven: "You are my beloved Son; with you I am well pleased."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a116" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>The time is fulfilled, and the kingdom of God is at hand; repent and believe in the gospel.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a117" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>Follow me, and I will make you become fishers of men.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a118" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>And immediately they left their nets and followed him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a119" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>And immediately he left his father Zebedee in the boat with the hired servants and followed him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a120" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>And immediately on the Sabbath he entered the synagogue and was teaching.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

    </TIER>

    <LINGUISTIC_TYPE GRAPHIC_REFERENCES="false" LINGUISTIC_TYPE_ID="utterance"   TIME_ALIGNABLE="true"  CONSTRAINTS="TIME_ALIGNABLE"/>
