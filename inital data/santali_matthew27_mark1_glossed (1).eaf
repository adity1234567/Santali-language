            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a40" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>nui d̪o ɟisu ɟiʰud̪i-koɾen ɾaɟ kana-e</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a41" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>isoɾ-ɾen hopon kan-am men-kʰan kɾus kʰon aɾɡon-me</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a42" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>isɾael-koɾen ɾaɟ kana-e nit̪-ok' kɾus kʰon-e aɾɡo hiɟ-uk'-ma ad̪o uni-ɾe bon pat̪iau-k'-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a43" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>eli eli lama sabakt̪ʰani metak'-me e iɲ-ɾen isoɾ e iɲ-ɾen isoɾ t͡ʃet̪-ak'-eɾ baɡi ɡid̪i-ad̪-iɲa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a44" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>saɾiɡe nui d̪o isoɾ-ɾen hopon-e t̪ahen-kana</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a45" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>alo-ben bot̪oɾ-ok'-a kɾus ok'-ol-en ɟisu-ben ɲam-e-kana</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a46" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>senkat̪-e uni-ɾen t͡ʃela lajakob-en ɡot͡ʃ'-ko kʰon-e ɟiwet̪' beɾet̪'-ena</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a47" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>alo-ben bot̪oɾ-ok'-a senkat̪-e iɲ-ɾen boeha-ko lajakob-en ɟemon ɡalil-t̪e-ko t͡ʃal-ak'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a48" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>seɾma-ɾe aɾ ot̪-ɾe sanam ekt̪iaɾi iɲ t̪ʰen em-akana</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a49" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>senkat̪-e sanam ɟat̪-ko t͡ʃela-ko-pe aɾ baba aɾ hopon aɾ sonot̪ ɟiu ɲut̪um-t̪e bapt̪is-ko-pe</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a50" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>iɲ d̪o ɟao hilok' ape t̪ulut͡ʃ' mena-ɲa ɟuɡ mukat̪'-habɪt͡ʃ'-ɡe</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a51" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>isoɾ-ɾen hopon ɟisu masi-ak' bʰaɡe sombat̪ ɾeak' et̪o-hop'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a52" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>ɟohan babapt̪isit͡ʃ' d̪o ɦaɦankaɾ-ɾe kai ik-ak' laɡit̪' mon at͡ʃuɾ ɾeak' bapt̪isma poɾt͡ʃaɾ-kan het͡ʃ'-ena</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a53" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>iɲ kʰon d̪aɾean-iʔ iɲ t̪ajom-t̪e d̪aɾae-kana one uniʔ-ak' kʰaɾpa ɾeak' t̪onol hɔ̃ eŋɡot̪'-kat̪e ɾaɾae-t̪ae lek d̪o-ɲ ba-ɲ kan</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>iɲ d̪o d̪ak'-t̪en bapt̪is-ked-ea uni d̪o sonot̪ ɟiu-t̪-e-je bapt̪is-pe-a</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>seɾma kʰon aɾan hɔj-ena am d̪o iɲ-ɾen d̪ulaɾia hopon kan-am aɾ-ɲ-ɾen kusiak-ana</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>okt̪e aʔo puɾau-akana aɾ isoɾ-ak' ɾaɟ d̪o soɾak-ana mon at͡ʃuɾ-pe aɾ bʰaɡe sombat̪-ɾe pat̪iau-k'-pe</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>d̪ela iɲ t̪ajom-t̪e ad̪o manwa sasap' keot̪an hoe ok'-ob-ena</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>kʰan ina t̪apt̪-eɡe ɟal-ko baɡi-at̪'-t̪ekin panɟ-akeda</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>kʰaŋɡe akin-ɾen apat̪ sabd̪ae d̪o laukaɾe munis-ko t̪ulut͡ʃ'-kin baɡi ot̪o-ad̪ea aɾ uni t̪ajom-t̪ekin t͡ʃalao-ena</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>aɾ paɦil ɟiɾauk' maɦa hilok'-ɡe sunaɡoɡ-ɾe boloj-ent̪e-je t͡ʃet̪'-at̪'-koa</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

