        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2" TIME_SLOT_REF1="ts3" TIME_SLOT_REF2="ts4">
                <ANNOTATION_VALUE>gɔgɔd̪ɔ ɘɖi aʈɛː haɾɔnakana mɛnkʰan ɔna haɾɔn d̪ɔ ba͡i̯ buɟʰhɘ͡o̯ oco͡akanna</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3" TIME_SLOT_REF1="ts5" TIME_SLOT_REF2="ts6">
                <ANNOTATION_VALUE>gɔgɔd̪ɔ ɘɖiː d̪ulɘɽkan tahɛna mɛnkʰan ɔlɔʔ paɽha͡o̯ bam d̪aɽɛlɛnkʰan sasa͡o̯ɛt̪ʔlɛ t̪ɛhɛna͡i̯</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4" TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>ɔko͡i̯ casɔʔ hɔɽ ɟɘsti kʰaʈaʔa unijaʔ pʰɔsɔld̪ɔ bʰagege hojo.a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5" TIME_SLOT_REF1="ts9" TIME_SLOT_REF2="ts10">
                <ANNOTATION_VALUE>baŋlad̪isɘm ɾenaʔ hasa d̪ɔ cas abad̪ lɘgit̪ʔ ɘɖi bʰage.ja</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>ɔnat̪ɛ casɔʔ hɔɽd̪ɔ hoɽo ɘkʰɾiɲ kat̪ɛʔ bako labʰ d̪aɽɛ.jaʔkana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
