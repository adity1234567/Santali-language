        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a479" ANNOTATION_REF="a478">
                <ANNOTATION_VALUE>childhood-LOC 1SG-TOP fever-PST-FIN and 1SG mother-TOP very much sorrow cry.out do-PST</ANNOTATION_VALUE>
            </REF_ANNOTATION>
