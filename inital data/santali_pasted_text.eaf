        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a33" TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE>manoʔakod̪ɔ gɔgɔʈʰɛnkʰɔnge pɘhil pɘɾsiko ceːd̪a</ANNOTATION_VALUE>
