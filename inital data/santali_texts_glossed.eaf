                <ANNOTATION_VALUE>manoa d̪ɔ gʰaɾɔ̃ɟkʰɔn ɟɘɾuɽaʔ gɔɽɔku ɲama</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14" TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>gʰaɾɔ̃ɟ boge d̪ɔhɔilɘgit̪ʔ ɟot̪ɔhɔɽaʔgi d̪ajikʔ menaa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15" TIME_SLOT_REF1="ts29" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>ɔkɔjaʔ ɖʰeɾ d̪aɽe noa niɘ mit̪ʔ d̪in hoi aɾ siɲ cand̪o t̪alaɾɛ kapʰaɾiɘ ɛhɔpʔena</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16" TIME_SLOT_REF1="ts31" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>siɲ cand̪oi mɛnked̪a ajaʔ d̪aɽe d̪ɔ hoikʰɔn hɔ̃ ɟɘst̪igetaja</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17" TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>aɾ hojɛ mɛnɛd̪a ajaʔ d̪aɽe d̪ɔ siɲ cand̪o kʰɔn hɔ̃ ɟɘst̪igetaja</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18" TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts36">
                <ANNOTATION_VALUE>un ɔkt̪ɛkin ɲɛlked̪a ɖahaɾt̪ɛ mit̪ʔ hɔɽɛ t̪aɽam id̪iid̪a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19" TIME_SLOT_REF1="ts37" TIME_SLOT_REF2="ts38">
                <ANNOTATION_VALUE>aɾ hoi d̪ɔ ɘɖi ɾaŋgaot̪ɛ ɔʈaŋɔʔ ɛhɔpʔena aɾ uni hɔɽaʔ kicɾiʲʔ d̪ɔ ɔʈaŋ calaʔ lɛkaina</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20" TIME_SLOT_REF1="ts39" TIME_SLOT_REF2="ts40">
                <ANNOTATION_VALUE>nɔŋka ɲɛlt̪ɛ uni hɔɽ d̪ɔ ajaʔ kicɾiʲʔ kaɟakt̪ɛi sapʔ uɾiʲʔked̪a</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21" TIME_SLOT_REF1="ts41" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>hoi kakʰanaʔt̪ɛ ɾejaɽ hɔ̃ ɾejaɽid̪ikan t̪ahɛ̃kana ɔna ijɘt̪ɛ aɾ mit̪ʔʈɛt̪ʔ picʰɘoɽit̪ɛi uju ɟuːt̪ena</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22" TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts44">
                <ANNOTATION_VALUE>aɾ hoi d̪ɔ uni hɔɽaʔ hɔɽmɔ kʰɔn kicɾiʲʔ bai ɔcɔʔ d̪aɽeoaʔt̪aja</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a23" TIME_SLOT_REF1="ts45" TIME_SLOT_REF2="ts46">
                <ANNOTATION_VALUE>ɔna t̪ajɔm siɲ cand̪o d̪ɔ ajaʔ d̪aɽe ud̪uʔɛ ɛhɔpʔena</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
