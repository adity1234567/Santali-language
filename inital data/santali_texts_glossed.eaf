                <ANNOTATION_VALUE>baba gɔgɔ aɾ gid̪ɾɘku sãot̪ɛ mit̪ʔʈɛʲʔ kɘʈiʈʔ gʰaɾɔ̃ɟ hojoʔa</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6" TIME_SLOT_REF1="ts11" TIME_SLOT_REF2="ts12">
                <ANNOTATION_VALUE>lɘʈu gʰaɾɔ̃ɟɾɛ d̪ɔ gɔgɔ baba bɔiha misɾa hɔpɔnba hɔpɔngɔ aɾ buɖɘ buɖigɔ mit̪ʔsãot̪ɛko t̪ahɛ̃na</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7" TIME_SLOT_REF1="ts13" TIME_SLOT_REF2="ts14">
                <ANNOTATION_VALUE>net̪aɾ d̪ɔ lɘʈu gʰaɾɔ̃ɟ ɾɘput̪ʔ kat̪ɛ kɘʈiʲʔ kɘʈiʲʔ gʰaɾɔ̃ɟ hojoʔkana</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
