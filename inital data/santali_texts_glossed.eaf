        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10" TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts20">
                <ANNOTATION_VALUE>sanam gʰaɾɔ̃ɟ ɾejaʔge ɟud̪ɘ ɟud̪ɘ pɘɾis aɾ bõs t̪ahɛ̃nt̪akoa</ANNOTATION_VALUE>
