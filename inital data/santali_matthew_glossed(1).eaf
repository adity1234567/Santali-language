    <!-- =================== TIER: ft (free translation) =================== -->
    <TIER LINGUISTIC_TYPE_REF="translation" PARENT_REF="ref" TIER_ID="ft">

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a301" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>Jesus is the one called the Baptist.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>The Kingdom of Heaven belongs to him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a303" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>This Good News is not only for the Jewish people.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a304" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>He had come to save the world.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a305" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>Satan tempted him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a306" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>Angels came and served him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a307" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>Jesus came from Galilee to the Jordan to John.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>John tried to prevent him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>We must fulfil all righteousness.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>The heavens were opened.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>This is my beloved Son.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>Repent, for the Kingdom of Heaven is near.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a313" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>Come follow me and I will make you fishers of men.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>The two of them immediately left the nets and followed him.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>Jesus went around the whole of Galilee teaching.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>All kinds of disease and illness among the people of the land.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>Blessed are the poor in spirit.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>Blessed are those who mourn.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>Blessed are the meek, for they shall inherit the earth.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>Blessed are the merciful, for they shall obtain mercy.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>You are the salt of the earth.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>You are the light of the world.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>Do not kill, and whoever kills will be liable to judgment.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>Whoever is angry with his brother will be liable to the court.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>Love your enemies, that they may be satisfied.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>

    </TIER>

