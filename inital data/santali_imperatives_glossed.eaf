    <!-- ============================================================ -->
    <!-- TIER 3: gl – gloss (child of mb, SYMBOLIC_ASSOCIATION)       -->
    <!-- Glossing abbreviations follow Ghosh 2008 and Leipzig rules:  -->
    <!-- IMP=imperative, PROHIB=prohibitive, POL=politeness marker,   -->
    <!-- NEG=negation (baŋ), PROH=prohibitive (alom),                 -->
    <!-- LOC=locative (-ɾɛ), ABL=ablative (-kʰɔn/-t̪e),              -->
    <!-- COMIT=comitative (-sã͡o), DIR=directional (-sɛʲc̚ʔ),         -->
    <!-- EMPH=emphatic (-gi), ORD=ordinal (-aʔ),                      -->
    <!-- 2SG=2nd person singular, 2PL=2nd person plural,              -->
    <!-- 3SG=3rd person singular, 3PL=3rd person plural,              -->
    <!-- 1SG=1st person singular, 1PL.EXCL=1st plural exclusive,      -->
    <!-- OBJ=object, REFL=reflexive, FIN=finite, Q=interrogative      -->
    <!-- ============================================================ -->
    <TIER LINGUISTIC_TYPE_REF="gloss" PARENT_REF="mb" TIER_ID="gl">

        <!-- A1: d̪a.ja kat̪ɛ bʰit̪ɾi sɛʲc̚ʔ hiɟuʔ-mɛ -->
